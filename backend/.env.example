# Copy to backend/.env and fill in. .env is gitignored.

PORT=3000
# Vite dev server origin, allowed by Socket.IO CORS
CLIENT_ORIGIN=http://localhost:5173

# MQTT broker (docker-compose Mosquitto in development)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/study-station

# Telegram alerts (duong)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Weekly email report (duong)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
