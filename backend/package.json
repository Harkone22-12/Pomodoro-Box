{
  "name": "study-station-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Study Station web backend: Express + MQTT.js + Socket.IO + Mongoose",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc",
